{
  "name": "codex-pet",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Codex Pet: a Windows desktop companion for Codex, based on dsh-pet",
  "homepage": "https://github.com/Wxy545/codex-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wxy545/codex-pet.git"
  },
